# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated allow-list. With three separate frontends, list all their origins:
#   client portal + admin portal + super admin portal
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (docker compose maps 5433 -> 5432 to avoid clashing with local PG)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://investment:investment@localhost:5433/investment?schema=public
POSTGRES_USER=investment
POSTGRES_PASSWORD=investment
POSTGRES_DB=investment
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
# Only expose invitation/reset tokens in API responses outside production.
EXPOSE_DEV_TOKENS=true

# ---------------------------------------------------------------------------
# Documents (private local object storage; swap for S3 in production)
# ---------------------------------------------------------------------------
STORAGE_DIR=./storage/documents
MAX_UPLOAD_MB=10
SIGNED_URL_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# Market prices
# stooq = free, keyless provider (gold: XAUUSD/oz, oil: CL.F/bbl)
# none  = provider disabled, manual overrides only
# ---------------------------------------------------------------------------
PRICE_PROVIDER=stooq
PRICE_REFRESH_CRON=*/15 * * * *
PRICE_STALE_MINUTES=60
ALLOW_ADMIN_PRICE_OVERRIDE=false

# ---------------------------------------------------------------------------
# Market news (optional). Without a key the API returns status=unconfigured.
# ---------------------------------------------------------------------------
NEWS_PROVIDER=newsapi
NEWS_API_KEY=
NEWS_CACHE_MINUTES=15
NEWS_QUERY=gold OR oil OR commodities

# ---------------------------------------------------------------------------
# Seed accounts (development only)
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123!
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=Client123!
