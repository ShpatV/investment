# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated allow-list. With three separate frontends, list all their origins:
#   client portal + admin portal + super admin portal
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=info
# Leave false when the API is directly exposed. Set true (or a hop count such as
# 1, or a trusted CIDR such as "loopback") when running behind a reverse proxy so
# client IPs and per-IP rate limits use X-Forwarded-For instead of the proxy IP.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Database (docker compose maps 5433 -> 5432 to avoid clashing with local PG)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://investment:investment@localhost:5433/investment?schema=public
POSTGRES_USER=investment
POSTGRES_PASSWORD=investment
POSTGRES_DB=investment
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
# Only expose invitation/reset tokens in API responses outside production.
EXPOSE_DEV_TOKENS=true

# ---------------------------------------------------------------------------
# Email delivery (SMTP) - optional
# When SMTP_HOST is set, invitation and password-reset emails are sent and the
# one-time token is no longer returned by the API. Without SMTP, tokens are
# exposed in API responses when EXPOSE_DEV_TOKENS=true (non-production only).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=true
MAIL_FROM=
MAIL_FROM_NAME=Investment Platform
# Frontend URLs used to build invite/reset links. Each app must implement the paths below.
CLIENT_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
MAIL_INVITE_PATH=/accept-invitation
MAIL_RESET_PATH=/reset-password

# ---------------------------------------------------------------------------
# Documents (private local object storage; swap for S3 in production)
# ---------------------------------------------------------------------------
STORAGE_DIR=./storage/documents
MAX_UPLOAD_MB=10
SIGNED_URL_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# Market prices
# stooq = free, keyless provider (gold: XAUUSD/oz, oil: CL.F/bbl)
# none  = provider disabled, manual overrides only
# ---------------------------------------------------------------------------
PRICE_PROVIDER=stooq
PRICE_REFRESH_CRON=*/15 * * * *
PRICE_STALE_MINUTES=60
ALLOW_ADMIN_PRICE_OVERRIDE=false

# ---------------------------------------------------------------------------
# Market news (optional). Without a key the API returns status=unconfigured.
# ---------------------------------------------------------------------------
NEWS_PROVIDER=newsapi
NEWS_API_KEY=
NEWS_CACHE_MINUTES=15
NEWS_QUERY=gold OR oil OR commodities

# ---------------------------------------------------------------------------
# Seed accounts (development only)
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123!
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=Client123!
